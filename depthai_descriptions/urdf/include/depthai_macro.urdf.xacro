<?xml version="1.0"?>
<robot name="depthai_camera"
	xmlns:xacro="http://ros.org/wiki/xacro">

	<!-- Camera and optical frames share the same structure for every sensor. -->
	<xacro:macro name="depthai_camera_frame"
		params="camera_name base_frame sensor_name joint_name xyz frame_suffix optical_frame_suffix rpy:='0 0 0'">
		<xacro:property name="M_PI" value="3.1415926535897931" />
		<link name="${camera_name}_${sensor_name}_${frame_suffix}" />
		<joint name="${camera_name}_${joint_name}_camera_joint" type="fixed">
			<parent link="${base_frame}" />
			<child link="${camera_name}_${sensor_name}_${frame_suffix}" />
			<origin xyz="${xyz}" rpy="${rpy}" />
		</joint>
		<link name="${camera_name}_${sensor_name}_${optical_frame_suffix}" />
		<joint name="${camera_name}_${joint_name}_camera_optical_joint" type="fixed">
			<origin xyz="0 0 0" rpy="-${M_PI/2} 0.0 -${M_PI/2}" />
			<parent link="${camera_name}_${sensor_name}_${frame_suffix}" />
			<child link="${camera_name}_${sensor_name}_${optical_frame_suffix}" />
		</joint>
	</xacro:macro>

	<!-- Recursive expansion preserves extra sockets on boards with >3 cameras. -->
	<xacro:macro name="depthai_extra_cameras" params="names cameras camera_name base_frame frame_suffix optical_frame_suffix">
		<xacro:if value="${len(names) > 0}">
			<xacro:property name="sensor" value="${names[0]}" />
			<xacro:depthai_camera_frame camera_name="${camera_name}" base_frame="${base_frame}"
				sensor_name="${sensor}" joint_name="${sensor}" xyz="${cameras[sensor]['xyz']}"
				rpy="${cameras[sensor]['rpy']}" frame_suffix="${frame_suffix}" optical_frame_suffix="${optical_frame_suffix}" />
			<xacro:depthai_extra_cameras names="${names[1:]}" cameras="${cameras}" camera_name="${camera_name}"
				base_frame="${base_frame}" frame_suffix="${frame_suffix}" optical_frame_suffix="${optical_frame_suffix}" />
		</xacro:if>
	</xacro:macro>

	<xacro:macro name="depthai_camera"
		params="camera_name camera_model parent base_frame 
                                           cam_pos_x cam_pos_y cam_pos_z 
                                           cam_roll cam_pitch cam_yaw r:=0.8 g:=0.8 b:=0.8 a:=0.8 simulation:=false rs_compat:=false imu_sensor:='' imu_frame:='optical'">

		<xacro:include filename="$(find depthai_descriptions)/urdf/include/base_macro.urdf.xacro" />
		<xacro:depthai_model_config camera_model="${camera_model}" imu_sensor="${imu_sensor}" imu_frame="${imu_frame}" />

		<xacro:if value="${rs_compat}">
			<xacro:property name="frame_suffix" value="frame" />
			<xacro:property name="optical_frame_suffix" value="optical_frame" />
			<xacro:property name="rgb_name" value="color" />
			<xacro:property name="left_name" value="infra2" />
			<xacro:property name="right_name" value="infra1" />
		</xacro:if>
		<xacro:unless value="${rs_compat}">
			<xacro:property name="frame_suffix" value="camera_frame" />
			<xacro:property name="optical_frame_suffix" value="camera_optical_frame" />
			<xacro:property name="rgb_name" value="rgb" />
			<xacro:property name="left_name" value="left" />
			<xacro:property name="right_name" value="right" />
		</xacro:unless>

		<xacro:base camera_name="${camera_name}" parent="${parent}" camera_model="${camera_model}"
			base_frame="${base_frame}" cam_pos_x="${cam_pos_x}" cam_pos_y="${cam_pos_y}"
			cam_pos_z="${cam_pos_z}" cam_roll="${cam_roll}" cam_pitch="${cam_pitch}"
			cam_yaw="${cam_yaw}" has_imu="${device_config['imu_xyz'] is not None}" simulation="${simulation}" imu_sensor="${imu_sensor}" imu_frame="${imu_frame}" />

		<xacro:if value="${device_config['rgb_xyz'] is not None}">
			<xacro:depthai_camera_frame camera_name="${camera_name}" base_frame="${base_frame}"
				sensor_name="${rgb_name}" joint_name="rgb" xyz="${device_config['rgb_xyz']}" rpy="${device_config['rgb_rpy']}"
				frame_suffix="${frame_suffix}" optical_frame_suffix="${optical_frame_suffix}" />
		</xacro:if>
		<xacro:if value="${device_config['left_xyz'] is not None}">
			<xacro:depthai_camera_frame camera_name="${camera_name}" base_frame="${base_frame}"
				sensor_name="${left_name}" joint_name="left" xyz="${device_config['left_xyz']}" rpy="${device_config['left_rpy']}"
				frame_suffix="${frame_suffix}" optical_frame_suffix="${optical_frame_suffix}" />
		</xacro:if>
		<xacro:if value="${device_config['right_xyz'] is not None}">
			<xacro:depthai_camera_frame camera_name="${camera_name}" base_frame="${base_frame}"
				sensor_name="${device_config['right_name'] or right_name}" joint_name="right" xyz="${device_config['right_xyz']}" rpy="${device_config['right_rpy']}"
				frame_suffix="${frame_suffix}" optical_frame_suffix="${optical_frame_suffix}" />
		</xacro:if>
		<xacro:depthai_extra_cameras names="${list(device_config['extra_cameras'].keys())}"
			cameras="${device_config['extra_cameras']}" camera_name="${camera_name}" base_frame="${base_frame}"
			frame_suffix="${frame_suffix}" optical_frame_suffix="${optical_frame_suffix}" />
	</xacro:macro>

</robot>
