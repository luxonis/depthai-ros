Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: gallery_world
    Background Color: 35; 35; 40
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.75
      Plane Cell Count: 30
      Color: 90; 90; 90
    - Class: rviz_default_plugins/RobotModel
      Name: All model meshes
      Enabled: true
      Alpha: 0.65
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /model_gallery/robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Sensor positions, axes and labels
      Enabled: true
      Marker Topic:
        Value: /model_gallery/markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: All TF frames (optional)
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.08
      Frames:
        All Enabled: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Pitch: 1.0
      Yaw: 0.5
      Focal Point:
        X: 2.6
        Y: -4.0
        Z: 0
Window Geometry:
  Width: 1500
  Height: 950
